# Скопируй этот файл в .env и заполни значения
# На Railway эти переменные задаются в Variables tab

# PostgreSQL (Railway добавляет автоматически если подключить PostgreSQL плагин)
# DATABASE_URL — Railway заполняет сам, НЕ нужно прописывать вручную
DATABASE_URL=postgresql://postgres:password@localhost:5432/skinpulse

# Или по частям (если не используешь DATABASE_URL):
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=skinpulse
# PG_USER=postgres
# PG_PASSWORD=postgres

# Порт (Railway заполняет сам через $PORT)
PORT=3000

# Интервал обновления в миллисекундах (по умолчанию 120000 = 2 мин)
UPDATE_INTERVAL=120000
